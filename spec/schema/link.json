{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.trailpad.ai/memory/0.1/link.json",
  "title": "Link",
  "type": "object",
  "required": ["id", "from", "type", "to"],
  "properties": {
    "id": { "$ref": "common.json#/$defs/id" },
